COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_MODELS_DIR=ComfyUI/models
COMFYUI_TIMEOUT_MS=1800000
# ADetailer/FaceDetailer face-crop size multiplier. 1 keeps crops small enough for
# Apple Silicon/MPS; raise to ~3 on CUDA/RunPod for more blending context.
COMFYUI_ADETAILER_CROP_FACTOR=1
COMFYUI_VIDEO_WORKFLOW_PATH=workflows/wan22-i2v-smoothmix-api.json
COMFYUI_AUDIO_WORKFLOW_PATH=
CIVITAI_API_TOKEN=
COMFYUI_ITP_WD14_MODEL=wd-swinv2-tagger-v3
COMFYUI_ITP_WD14_THRESHOLD=0.35
COMFYUI_ITP_WD14_CHARACTER_THRESHOLD=0.85
COMFYUI_ITP_WD14_EXCLUDE_TAGS=
COMFYUI_ITP_WD14_WORKFLOW_PATH=
COMFYUI_ITP_FLORENCE_WORKFLOW_PATH=

# AUTOMATIC1111 API
A1111_BASE_URL=http://127.0.0.1:7860
FORGE_BASE_URL=http://127.0.0.1:7861
A1111_TIMEOUT_MS=3600000
WEBUI_BOOT_TIMEOUT_MS=300000
# Optional: override automatic A1111/Forge startup commands.
# A1111_LAUNCH_CMD=
# FORGE_LAUNCH_CMD=
